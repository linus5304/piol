# ============================================
# PIOL - Environment Variables Configuration
# ============================================
# Copy this file to .env.local and fill in your values
# All variables marked as REQUIRED must be set for production
# Variables marked as OPTIONAL have sensible defaults
#
# ============================================
# 🚀 PRODUCTION SETUP CHECKLIST
# ============================================
# 1. Create production Clerk app (or switch existing to production)
# 2. Create production Convex deployment: npx convex deploy --prod
# 3. Set CLERK_JWT_ISSUER_DOMAIN in Convex Dashboard (prod deployment)
# 4. Create JWT template named "convex" in Clerk Dashboard
# 5. Set all REQUIRED vars below with production values
# 6. Configure Vercel environment variables (or your host)
# 7. Set GitHub Actions secrets (see bottom of this file)
#
# For staging, create separate Clerk/Convex deployments

# ============================================
# 🔐 CLERK AUTHENTICATION
# ============================================
# Get your keys from: https://clerk.com/dashboard
# REQUIRED for authentication features
#
# ⚠️  ENVIRONMENT-SPECIFIC KEYS (Vercel Deployments)
# ---------------------------------------------------
# Clerk keys MUST differ per Vercel environment target:
#
#   LOCAL DEV:    Test keys (pk_test_*, sk_test_*) — no domain restriction
#   PREVIEW:      Test keys (pk_test_*, sk_test_*) — Clerk rejects prod keys on *.vercel.app
#   PRODUCTION:   Test keys (pre-launch) or Live keys (pk_live_*, sk_live_*)
#                 Live keys require a custom domain configured in Clerk Dashboard
#
# Set per-environment keys in Vercel Dashboard → Settings → Environment Variables
# or via CLI: vercel env add NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY preview
#
# See CLAUDE.md "Deployment & Authentication" for full details.

# Publishable Key (safe to expose to client)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Secret Key (server-side only, never expose!)
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Webhook Secret (for syncing users to Convex)
CLERK_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ============================================
# 🔗 CLERK REDIRECT URLS
# ============================================
# OPTIONAL - defaults shown below

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/onboarding

# ============================================
# 📦 CONVEX DATABASE
# ============================================
# Get your URL from: https://dashboard.convex.dev
# REQUIRED for database features

# Your Convex deployment URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Temporary migration fallback (deprecated):
# If NEXT_PUBLIC_CONVEX_URL is missing, app will use CONVEX_URL.
# Prefer NEXT_PUBLIC_CONVEX_URL for all new setups.
# CONVEX_URL=https://your-deployment.convex.cloud

# Deployment name (for CLI commands)
CONVEX_DEPLOYMENT=dev:your-deployment

# ============================================
# 🔐 CONVEX AUTHENTICATION (set in Convex Dashboard)
# ============================================
# These must be set in Convex Dashboard → Settings → Environment Variables
# NOT in .env.local (they run on Convex servers, not Next.js)
#
# CLERK_JWT_ISSUER_DOMAIN=your-app.clerk.accounts.dev
#   → Your Clerk domain (found in Clerk Dashboard → API Keys)
#   → Required for Convex to validate Clerk JWTs
#   → Must match the Clerk keys being used:
#       Test keys  → busy-heron-88.clerk.accounts.dev
#       Live keys  → your Clerk production domain
#
# To set: npx convex dashboard → Settings → Environment Variables
#
# CLERK_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
#   → Used by Convex HTTP endpoint /clerk-webhook for signature verification
#
# CONVEX_SITE_URL=https://your-deployment.convex.site
#   → Base URL for Convex HTTP actions/webhooks
#   → Required for Orange Money notify callback URL composition
CONVEX_SITE_URL=https://your-deployment.convex.site

# ============================================
# 🐛 SENTRY ERROR TRACKING
# ============================================
# Get your DSN from: https://sentry.io
# OPTIONAL - errors won't be tracked if not set

# Client-side DSN (safe to expose)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# For source map uploads (build-time only, never expose!)
SENTRY_AUTH_TOKEN=sntrys_YOUR_TOKEN
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=piol-web

# ============================================
# 🌐 APP CONFIGURATION
# ============================================
# OPTIONAL - defaults shown below

# Your app's public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App name used in metadata
NEXT_PUBLIC_APP_NAME=Piol

# Staged payments rollout flag
# false = hide payment initiation actions, keep transaction history visible
# true  = show payment initiation actions
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ============================================
# 🌍 GENERAL TRANSLATION (i18n)
# ============================================
# REQUIRED for General Translation managed translations

# Server-side project id (preferred by gt-next plugin)
GT_PROJECT_ID=your-gt-project-id

# Public alias used by app config during rollout
NEXT_PUBLIC_GT_PROJECT_ID=your-gt-project-id

# Server-side API key (production translation operations)
GT_API_KEY=gt_api_YOUR_KEY

# ============================================
# 💰 MTN MOMO PAYMENTS
# ============================================
# Get your credentials from: https://momodeveloper.mtn.com
# REQUIRED for MTN Mobile Money payments
#
# Set these in Convex Dashboard (dev and prod deployments),
# because Convex actions read them server-side.

MTN_MOMO_API_USER=your-api-user-uuid
MTN_MOMO_API_KEY=your-api-key
MTN_MOMO_SUBSCRIPTION_KEY=your-subscription-key
MTN_MOMO_ENVIRONMENT=sandbox
# For production use: MTN_MOMO_ENVIRONMENT=production

# ============================================
# 🍊 ORANGE MONEY PAYMENTS
# ============================================
# Get your credentials from: Orange Money developer portal
# REQUIRED for Orange Money payments
#
# Set these in Convex Dashboard (dev and prod deployments),
# because Convex actions read them server-side.

ORANGE_MONEY_CLIENT_ID=your-client-id
ORANGE_MONEY_CLIENT_SECRET=your-client-secret
ORANGE_MONEY_MERCHANT_KEY=your-merchant-key
ORANGE_MONEY_ENVIRONMENT=sandbox
# For production use: ORANGE_MONEY_ENVIRONMENT=production

# ============================================
# 🔧 BUILD CONFIGURATION
# ============================================
# OPTIONAL - for special build scenarios

# Skip env validation (useful for Docker builds)
# SKIP_ENV_VALIDATION=true

# Node environment
NODE_ENV=development

# ============================================
# 🤖 GITHUB ACTIONS SECRETS
# ============================================
# These are NOT set in .env.local - they're GitHub repository secrets
# Go to: GitHub → Settings → Secrets → Actions
#
# ANTHROPIC_API_KEY
#   → For Claude PR Assistant and Security Review workflows
#   → Get from: https://console.anthropic.com/settings/keys
#
# VERCEL_TOKEN
#   → For automated deployments
#   → Get from: https://vercel.com/account/tokens
#
# VERCEL_ORG_ID
#   → Your Vercel team/org ID
#   → Found in: Vercel → Settings → General
#
# VERCEL_PROJECT_ID
#   → Your Vercel project ID
#   → Found in: Vercel → Project → Settings → General
#
# CONVEX_DEPLOY_KEY
#   → For Convex production deployments
#   → Get from: npx convex deploy --prod (first time setup)
